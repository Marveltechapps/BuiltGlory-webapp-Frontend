# Staging web app. Set this before `npm run build`. Next.js inlines NEXT_PUBLIC_* at build time.
# Do not commit a filled .env. Validate with: npm run env:validate:staging:example
#
# Proposed hostname only. DNS is not configured by this repository.
NEXT_PUBLIC_API_BASE_URL=https://staging-api.builtglory.com/api/v1
